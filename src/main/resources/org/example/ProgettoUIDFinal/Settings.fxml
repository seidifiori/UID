      </Label>
      <Label layoutX="214.0" layoutY="165.0" text="Tema Scuro">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Label layoutX="206.0" layoutY="279.0" text="Musica">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Button layoutX="119.0" layoutY="271.0" mnemonicParsing="false" prefHeight="62.0" prefWidth="19.0" style="-fx-background-color: transparent;" />
