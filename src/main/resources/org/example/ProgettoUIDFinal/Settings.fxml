            <ImageView fitHeight="112.0" fitWidth="72.0" pickOnBounds="true" preserveRatio="true" />
         </graphic>
      </Button>
      <Button layoutX="108.0" layoutY="257.0" mnemonicParsing="false" onAction="#toggleMusicMute" prefHeight="62.0" prefWidth="19.0" style="-fx-background-color: transparent;">
