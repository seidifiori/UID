<AnchorPane prefHeight="650.0" prefWidth="1080.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ProgettoUIDFinal.SettingsController">
   <children>
      <ImageView fitHeight="650.0" fitWidth="1080.0" pickOnBounds="true">
