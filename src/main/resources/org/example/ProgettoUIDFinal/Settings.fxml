         </graphic>
      </Button>
      <Button fx:id="QuitButton" layoutX="557.0" layoutY="253.0" mnemonicParsing="false" onAction="#exitGame" prefHeight="62.0" prefWidth="19.0" style="-fx-background-color: transparent;">
